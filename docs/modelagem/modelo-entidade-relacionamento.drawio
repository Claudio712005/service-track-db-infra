        <mxCell id="chkt" value="&lt;i&gt;Enums da aplicação espelhados no banco.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;usuario_roles.role&lt;/b&gt;&lt;br&gt;CLIENTE · MECANICO&lt;br&gt;&lt;br&gt;&lt;b&gt;mecanicos.nivel&lt;/b&gt;&lt;br&gt;JUNIOR · PLENO · SENIOR&lt;br&gt;&lt;br&gt;&lt;b&gt;ordens_servico.status&lt;/b&gt;&lt;br&gt;CANCELADA · RECEBIDA · EM_DIAGNOSTICO ·&lt;br&gt;AGUARDANDO_APROVACAO · EM_EXECUCAO ·&lt;br&gt;FINALIZADA · ENTREGUE&lt;br&gt;&lt;br&gt;&lt;b&gt;veiculos.ativo&lt;/b&gt;&lt;br&gt;S · N&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#C62828&quot;&gt;(varchar, não boolean — M-06)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;notificacoes.tipo_notificacao&lt;/b&gt;&lt;br&gt;EMAIL&lt;br&gt;&lt;br&gt;&lt;b&gt;notificacoes.status_envio&lt;/b&gt;&lt;br&gt;PENDENTE · ENVIADA · FALHA_ENVIO&lt;br&gt;&lt;br&gt;&lt;b&gt;notificacoes.tipo_conteudo_notificacao&lt;/b&gt;&amp;nbsp;&lt;i&gt;(V3)&lt;/i&gt;&lt;br&gt;MUDANCA_STATUS_OS ·&lt;br&gt;SOLICITACAO_APROVACAO_ORCAMENTO_OS ·&lt;br&gt;DECISAO_ORCAMENTO_OS&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#C62828&quot;&gt;Mudar o enum da aplicação sem migration nova quebra a inserção em runtime.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#5D4037;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="470" y="728" width="348" height="394" as="geometry"/>
        </mxCell>
        <mxCell id="nota_aud" value="Sem relacionamento declarado. &lt;b&gt;Deliberado&lt;/b&gt;: a trilha de auditoria precisa&lt;br&gt;sobreviver à remoção do usuário, por isso responsavel_acao é varchar(36)&lt;br&gt;sem FK. As duas únicas linhas com índice explícito do schema estão aqui." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=10;fontSize=9;fontColor=#7F1D1D;" vertex="1" parent="1">
